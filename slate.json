{
  "include": [
    "slates/Platforms.json",
    "slates/Tools.json"
  ],
  "env": [
    "LLVM_MINGW_ROOT",
    "VCPKG_INSTALLED_DIR",
    "SALTS_BASE_ROOT",
    "CMETA_ROOT",
    "SALTS_CNET_ROOT",
    "SALTS_UTILS_ROOT",
    "SALTSNET_ROOT",
    "CHTTP_ROOT",
    "TURBOMEDIA_RE2C_ROOT",
    "LEMON_ROOT"
  ],
  "modules": [
    "third_party",
    "streamgraph",
    "media",
    "sip",
    "streaming",
    "webrtc",
    "examples"
  ],
  "defaultPreset": "release",
  "presets": {
    "base": {
      "cStd": "gnu11",
      "cxxStd": "c++17",
      "tests": false
    },
    "release": {
      "inherits": "base",
      "config": "release",
      "options": {
        "optimization": "speed"
      },
      "defines": {
        "NDEBUG": null
      }
    },
    "debug": {
      "inherits": "base",
      "config": "debug",
      "options": {
        "optimization": "none",
        "debugInfo": "full"
      }
    },
    "tests": {
      "inherits": "release",
      "tests": true
    },
    "debug-tests": {
      "inherits": "debug",
      "tests": true
    },
    "benchmark": {
      "inherits": "release",
      "config": "benchmark",
      "tests": true
    }
  }
}
