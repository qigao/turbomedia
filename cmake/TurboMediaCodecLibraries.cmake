function(turbo_media_find_codec_libraries component)
  set(dependencies TurboMediaCodecDeps::${component})
  if(TARGET ${dependencies})
    return()
  endif()
  if(component STREQUAL "AudioCodec")
    find_library(OPUS_LIBRARY NAMES opus REQUIRED)
    set(libraries "${OPUS_LIBRARY}")
  elseif(component STREQUAL "VideoCodec")
    find_library(VPX_LIBRARY NAMES vpx libvpx REQUIRED)
    find_library(OPENH264_LIBRARY NAMES openh264 wels REQUIRED)
    find_library(X265_LIBRARY NAMES x265 libx265 REQUIRED)
    find_library(LIBDE265_LIBRARY NAMES de265 libde265 REQUIRED)
    set(libraries "${VPX_LIBRARY}" "${OPENH264_LIBRARY}" "${X265_LIBRARY}" "${LIBDE265_LIBRARY}")
  else()
    message(FATAL_ERROR "Unknown codec component: ${component}")
  endif()
  add_library(${dependencies} INTERFACE IMPORTED)
  target_link_libraries(${dependencies} INTERFACE ${libraries})
  if(UNIX OR MINGW)
    find_package(Threads REQUIRED)
    target_link_libraries(${dependencies} INTERFACE
      Threads::Threads ${CMAKE_DL_LIBS} $<$<PLATFORM_ID:Linux>:m>)
  endif()
endfunction()
