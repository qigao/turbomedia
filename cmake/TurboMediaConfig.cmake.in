@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Salts CONFIG REQUIRED
                PATHS "$ENV{SALTS_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
find_dependency(SaltsUtils CONFIG REQUIRED
                PATHS "$ENV{SALTS_UTILS_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
if(NOT TARGET Salts::Capture)
  set(TurboMedia_FOUND FALSE)
  set(TurboMedia_NOT_FOUND_MESSAGE
      "SaltsUtils profile does not export Salts::Capture")
  return()
endif()
find_dependency(SaltsNet CONFIG REQUIRED
                PATHS "$ENV{SALTSNET_ROOT}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)


# The exported target file contains all TurboMedia components, but FFmpeg is
# only a dependency of this component closure.  Keep non-media consumers
# (for example Core, Device, or WebRTC) usable without FFmpeg development files.
set(_TurboMedia_ffmpeg_components Muxer Demuxer Player Pipeline Streamer RtcApps)
set(_TurboMedia_requires_ffmpeg FALSE)
if(NOT TurboMedia_FIND_COMPONENTS)
  set(_TurboMedia_requires_ffmpeg TRUE)
else()
  foreach(_TurboMedia_requested_component IN LISTS TurboMedia_FIND_COMPONENTS)
    if(_TurboMedia_requested_component IN_LIST _TurboMedia_ffmpeg_components)
      set(_TurboMedia_requires_ffmpeg TRUE)
      break()
    endif()
  endforeach()
endif()

if(_TurboMedia_requires_ffmpeg)
  find_path(FFMPEG_INCLUDE_DIRS NAMES libavformat/avformat.h REQUIRED)
  foreach(_TurboMedia_ffmpeg_component IN ITEMS avformat avcodec avfilter avutil
                                                swresample swscale)
    find_library(
      FFMPEG_lib${_TurboMedia_ffmpeg_component}_LIBRARY
      NAMES ${_TurboMedia_ffmpeg_component}
      REQUIRED)
  endforeach()
  include("${CMAKE_CURRENT_LIST_DIR}/TurboMediaFFmpegTargets.cmake")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboMediaTargets.cmake")

foreach(_TurboMedia_component IN LISTS TurboMedia_FIND_COMPONENTS)
  if(TARGET TurboMedia::${_TurboMedia_component})
    set(TurboMedia_${_TurboMedia_component}_FOUND TRUE)
  else()
    set(TurboMedia_${_TurboMedia_component}_FOUND FALSE)
  endif()
endforeach()

check_required_components(TurboMedia)

unset(_TurboMedia_component)
unset(_TurboMedia_ffmpeg_component)
unset(_TurboMedia_ffmpeg_components)
unset(_TurboMedia_requested_component)
unset(_TurboMedia_requires_ffmpeg)
