@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(NOT TARGET TurboUtils::Core)
  find_dependency(TurboUtils CONFIG)
endif()

if(@TurboHttp_FOUND@ AND NOT TARGET TurboHttp::HttpClient)
  find_dependency(TurboHttp CONFIG)
endif()

if(@TURBO_MEDIA_ENABLE_WEBRTC@ AND NOT TARGET OpenSSL::Crypto)
  find_dependency(OpenSSL)
endif()

if(@TURBO_MEDIA_ENABLE_WEBRTC@ AND NOT TARGET libSRTP::srtp2)
  find_package(libSRTP CONFIG QUIET)
  if(NOT TARGET libSRTP::srtp2)
    find_dependency(libsrtp CONFIG)
  endif()
endif()

if(@TurboNet_FOUND@)
  find_dependency(Threads)
  if(NOT TARGET TurboUtils::Core)
    find_dependency(TurboUtils CONFIG)
  endif()
  if(NOT TARGET TurboNet::CoroNet)
    find_dependency(TurboNet CONFIG)
  endif()
endif()

if(@TURBO_MEDIA_ENABLE_WEBRTC@)
  if(NOT TARGET TurboUtils::Core)
    find_dependency(TurboUtils CONFIG)
  endif()
  if(NOT TARGET TurboNet::Ice)
    find_dependency(TurboNet CONFIG)
  endif()
endif()

set(_TurboMedia_need_webrtc_signaling_deps FALSE)
if(@TURBO_MEDIA_ENABLE_WEBRTC@)
  if(NOT TurboMedia_FIND_COMPONENTS)
    set(_TurboMedia_need_webrtc_signaling_deps TRUE)
  else()
    foreach(_TurboMedia_component IN LISTS TurboMedia_FIND_COMPONENTS)
      if(_TurboMedia_component STREQUAL "WebRTCSignaling")
        set(_TurboMedia_need_webrtc_signaling_deps TRUE)
      endif()
    endforeach()
  endif()
endif()

if(_TurboMedia_need_webrtc_signaling_deps AND NOT TARGET TurboHttp::Iris)
  find_dependency(TurboHttp CONFIG)
endif()

set(TurboMedia_Media_FOUND TRUE)
set(TurboMedia_Crypto_FOUND FALSE)
set(TurboMedia_RTSP_FOUND FALSE)
set(TurboMedia_WebRTC_FOUND FALSE)
set(TurboMedia_WebRTCSignaling_FOUND FALSE)
set(TurboMedia_RTC_FOUND FALSE)
set(_TurboMedia_need_rtsp_deps FALSE)

if(@TURBO_MEDIA_ENABLE_RTSP@)
  if(NOT TurboMedia_FIND_COMPONENTS)
    set(_TurboMedia_need_rtsp_deps TRUE)
  else()
    foreach(_TurboMedia_component IN LISTS TurboMedia_FIND_COMPONENTS)
      if(_TurboMedia_component STREQUAL "RTSP")
        set(_TurboMedia_need_rtsp_deps TRUE)
      endif()
    endforeach()
  endif()
endif()

if(_TurboMedia_need_rtsp_deps)
  find_dependency(Threads)
  find_dependency(TurboNet CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/TurboMediaTargets.cmake")

if(TARGET TurboMedia::Crypto)
  set(TurboMedia_Crypto_FOUND TRUE)
endif()

if(TARGET TurboMedia::RTSP)
  set(TurboMedia_RTSP_FOUND TRUE)
endif()

if(TARGET TurboMedia::WebRTC AND TARGET TurboMedia::DataChannel AND
   TARGET TurboMedia::SDP)
  set(TurboMedia_WebRTC_FOUND TRUE)
endif()

if(TARGET TurboMedia::WebRTCSignaling)
  set(TurboMedia_WebRTCSignaling_FOUND TRUE)
endif()

if(TARGET TurboMedia::RTC AND TurboMedia_WebRTC_FOUND AND TurboMedia_Crypto_FOUND)
  set(TurboMedia_RTC_FOUND TRUE)
endif()

check_required_components(TurboMedia)

unset(_TurboMedia_need_rtsp_deps)
unset(_TurboMedia_need_webrtc_signaling_deps)
unset(_TurboMedia_component)
