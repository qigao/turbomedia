# Load the selected fields into the shell before invoking CMake or vcpkg.
# Use a checkout at the selected vcpkg-cache release.
VCPKG_CACHE_VERSION=0.1.8
VCPKG_CACHE_REPOSITORY_ROOT=C:/projects/cpp/turbonet/vcpkg-cache-v0.1.8
# Split SDK versions. Restore SaltsCNet with the DTLS-SRTP API and SaltsNet ICE
# with native send completion draining for the full TurboMedia build.
SALTS_BASE_VERSION=0.1.10
CMETA_VERSION=0.1.10
SALTS_CNET_VERSION=0.1.18
SALTS_UTILS_VERSION=0.1.8
CHTTP_VERSION=0.1.4
# SALTS_BASE_ROOT=C:/shared/salts-base
# CMETA_ROOT=C:/shared/cmeta
# SALTS_CNET_ROOT=C:/shared/salts-cnet
# SALTS_UTILS_ROOT=C:/shared/salts-utils
# CHTTP_ROOT=C:/shared/chttp-0.1.4-ws-peer-lease
# SALTSNET_ROOT=C:/shared/salts-net-built-with-split-sdk
LLVM_MINGW_ROOT=C:/tools/llvm-mingw
# Windows Workbench GUI source, verified by CMake FetchContent.
OPENWTL_VERSION=0.1.2
OPENWTL_SHA256=9fbe6cc68d23ee37bbd4ae4e2a54f64b4d428f2837f0d557687d9551fde485bd
VCPKG_TARGET_TRIPLET=qigao-x64-windows-llvm-mingw
CMAKE_BUILD_PARALLEL_LEVEL=3
# Reuse the restored vcpkg-cache dependencies and host tools across projects.
# A complete TurboMedia install prefix also needs the ports from vcpkg.json.
# VCPKG_INSTALLED_DIR=C:/shared/vcpkg-cache/payload/vcpkg_installed
# SHARED_DEPENDENCY_ROOT=C:/shared/native
# RE2C_ROOT=C:/shared/re2c/tools/windows-x64
# LEMON_ROOT=C:/shared/lemon/tools/windows-x64
# VCPKG_BINARY_CACHE=C:/shared/vcpkg-cache/build/binary-cache
# VCPKG_BINARY_SOURCES=clear;files,C:/shared/vcpkg-cache/build/binary-cache,readwrite;default,read
# Use the matching compiler profile when restoring SDKs.
# TURBORAFT_ROOT=C:/sdk/turboraft-0.3.2
# Supply GITHUB_TOKEN in the parent environment (an authenticated gh login can supply it).
TURBORAFT_VERSION=0.3.2
TURBODB_VERSION=0.1.3
