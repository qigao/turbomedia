{
  "include": ["tests/module.json"],
  "targets": {
    "turbo_media_streamgraph": {
      "kind": "shared",
      "outputPrefix": "lib",
      "sources": {
        "files": [
          "src/turbo_streamgraph.c",
          "src/turbo_frame_store.c",
          "src/turbo_streamgraph_fanout.c",
          "src/turbo_streamgraph_executor.c",
          "src/turbo_streamgraph_handoff.c",
          "src/turbo_streamgraph_owner_dispatch.c",
          "src/turbo_streamgraph_provider_completion.c"
        ]
      },
      "public": {
        "includeDirs": ["include", "../media/codec/include"]
      },
      "private": {
        "defines": {
          "SHARED_CXX": null,
          "turbo_media_streamgraph_EXPORTS": null
        },
        "flags": ["-Wall", "-Wextra", "-Werror", "-pedantic", "-Wno-unused-parameter", "-fvisibility=hidden"]
      },
      "install": {
        "headers": [
          {
            "from": "include/*.h",
            "to": "include"
          },
          {
            "from": "$root/media/codec/include/turbo_export.h",
            "to": "include"
          }
        ]
      }
    }
  }
}
