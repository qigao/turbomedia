{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-paths",
            "hidden": true,
            "cacheVariables": { 
                "TURBONET_ROOT": "c:/projects/cpp/external/pkgs/turbonet", 
                "CMAKE_MAKE_PROGRAM": "C:/Users/lockg/scoop/shims/ninja.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "VCPKG_ROOT": "C:/tools/vcpkg"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
         {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "TURBONET_ROOT": "/opt/turbonet", 
                "CMAKE_MAKE_PROGRAM": "/usr/bin/ninja"
            },
            "environment": {
                "VCPKG_ROOT": "/opt/vcpkg"
            }
        },
        {
            "name": "win-dev-user",
            "displayName": "Developer Build (Windows, User)",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/x64-windows/debug",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/x64-windows/tools/pkgconf/pkgconf.exe"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "displayName": "Release Build (Windows, User)",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/x64-windows",
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/x64-windows/tools/pkgconf/pkgconf.exe"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "linux-dev-user",
            "displayName": "Developer Build (Linux, User)",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/x64-linux/"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-release-user",
            "displayName": "Release Build (Linux, User)",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "CMAKE_PREFIX_PATH": "${sourceDir}/vcpkg_installed/x64-linux"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "win-dev-user",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "configurePreset": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "configurePreset": "linux-release-user"
        }
    ],
    "testPresets": [
        {
            "name": "win-dev-user",
            "configurePreset": "win-dev-user",
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "win-release-user",
            "configurePreset": "win-release-user",
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-dev-user",
            "configurePreset": "linux-dev-user",
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-release-user",
            "configurePreset": "linux-release-user",
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            },
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
