{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "vcpkg-cache-ci",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{VCPKG_CACHE_REPOSITORY_ROOT}",
                "VCPKG_BINARY_SOURCES": "$penv{VCPKG_BINARY_SOURCES}"
            }
        },
        {
            "name": "vcpkg-cache-linux",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-linux"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{HOME}/.cache/qigao/vcpkg-cache"
            }
        },
        {
            "name": "vcpkg-cache-windows",
            "hidden": true,
            "inherits": "vcpkg-cache",
            "cacheVariables": {
                "VCPKG_HOST_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_CACHE_REPOSITORY_ROOT": "$penv{LOCALAPPDATA}/qigao/vcpkg-cache",
                "RE2C_ROOT": "$env{PKG_ROOT}/re2c/windows-x64"
            }
        },
        {
            "name": "vcpkg-cache",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/cmake/QigaoVcpkgToolchain.cmake",
            "environment": {
                "VCPKG_BINARY_SOURCES": "clear;default,readwrite;nugettimeout,1800;nugetconfig,${sourceDir}/cmake/vcpkg-cache.nuget.config,read",
                "VCPKG_OVERLAY_PORTS": "$env{VCPKG_CACHE_REPOSITORY_ROOT}/ports",
                "RE2C_ROOT": "$penv{RE2C_ROOT}",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}$penv{PATH}"
            }
        },
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_ROOT": "C:/tools/vcpkg",
                "USER_ROOT": "C:/Users/lockg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            },
            "inherits": [
                "vcpkg-cache-windows"
            ]
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "host=x64",
                "strategy": "external"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON",
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            },
            "inherits": [
                "vcpkg-cache-linux"
            ]
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "environment": {
                "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            }
        },
        {
            "name": "android-win-user-paths",
            "hidden": true,
            "inherits": [
                "vcpkg-cache-windows",
                "android-win-paths",
                "ISWindows"
            ],
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbomedia/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/http-services/debug",
                "SALTSNET_ROOT": "$env{PKG_ROOT}/saltsnet/debug",
                "RULES_FORGE_ROOT": "$env{PKG_ROOT}/rules_forge/debug",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$env{SALTSNET_ROOT}/bin${pathListSep}$env{RULES_FORGE_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-dev-user",
                "win-paths"
            ]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbomedia/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/http-services/release",
                "SALTSNET_ROOT": "$env{PKG_ROOT}/saltsnet/release",
                "RULES_FORGE_ROOT": "$env{PKG_ROOT}/rules_forge/release",
                "PATH": "$env{RE2C_ROOT}/bin${pathListSep}${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{SALTS_UTILS_ROOT}/bin${pathListSep}$env{CHTTP_ROOT}/bin${pathListSep}$env{SALTSNET_ROOT}/bin${pathListSep}$env{RULES_FORGE_ROOT}/bin${pathListSep}$penv{PATH}"
            },
            "inherits": [
                "base-win-release-user",
                "win-paths"
            ]
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbomedia/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/http-services/debug",
                "SALTSNET_ROOT": "$env{PKG_ROOT}/saltsnet/debug",
                "RULES_FORGE_ROOT": "$env{PKG_ROOT}/rules_forge/debug",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTSNET_ROOT}/lib${pathListSep}$env{RULES_FORGE_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "base-linux-dev-user",
                "linux-paths"
            ]
        },
        {
            "name": "linux-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbomedia/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/http-services/release",
                "SALTSNET_ROOT": "$env{PKG_ROOT}/saltsnet/release",
                "RULES_FORGE_ROOT": "$env{PKG_ROOT}/rules_forge/release",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{SALTS_UTILS_ROOT}/lib${pathListSep}$env{CHTTP_ROOT}/lib${pathListSep}$env{SALTSNET_ROOT}/lib${pathListSep}$env{RULES_FORGE_ROOT}/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": [
                "release-linux-ninja",
                "linux-paths"
            ]
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/debug",
                "CHTTP_ROOT": "$env{PKG_ROOT}/http-services-android/debug",
                "SALTS_UTILS_HOST_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "SALTSNET_ROOT": "$env{PKG_ROOT}/saltsnet-android/debug",
                "RULES_FORGE_ROOT": "$env{PKG_ROOT}/rules_forge-android/debug"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbomedia-android/debug"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release",
                "SALTS_UTILS_ROOT": "$env{PKG_ROOT}/salts-utils-android/release",
                "CHTTP_ROOT": "$env{PKG_ROOT}/http-services-android/release",
                "SALTS_UTILS_HOST_ROOT": "$env{PKG_ROOT}/salts-utils/release",
                "SALTSNET_ROOT": "$env{PKG_ROOT}/saltsnet-android/release",
                "RULES_FORGE_ROOT": "$env{PKG_ROOT}/rules_forge-android/release"
            },
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbomedia-android/release"
            }
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "inherits": [
                "android-arm64-v8a-debug",
                "android-dependencies-debug",
                "android-win-user-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-arm64-v8a-release-win",
            "inherits": [
                "android-arm64-v8a-release",
                "android-dependencies-release",
                "android-win-user-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86_64-debug-win",
            "inherits": [
                "android-x86_64-debug",
                "android-dependencies-debug",
                "android-win-user-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86_64-release-win",
            "inherits": [
                "android-x86_64-release",
                "android-dependencies-release",
                "android-win-user-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86-debug-win",
            "inherits": [
                "android-x86-debug",
                "android-dependencies-debug",
                "android-win-user-paths",
                "android-win-environment"
            ]
        },
        {
            "name": "android-x86-release-win",
            "inherits": [
                "android-x86-release",
                "android-dependencies-release",
                "android-win-user-paths",
                "android-win-environment"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "win-dev-user",
            "configurePreset": "win-dev-user"
        },
        {
            "name": "win-release-user",
            "configurePreset": "win-release-user"
        },
        {
            "name": "linux-dev-user",
            "configurePreset": "linux-dev-user"
        },
        {
            "name": "linux-release-user",
            "configurePreset": "linux-release-user"
        },
        {
            "name": "install-win-dev-user",
            "configurePreset": "win-dev-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-win-release-user",
            "configurePreset": "win-release-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-linux-dev-user",
            "configurePreset": "linux-dev-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-linux-release-user",
            "configurePreset": "linux-release-user",
            "targets": [
                "install"
            ]
        },
        {
            "name": "android-arm64-v8a-debug-win",
            "configurePreset": "android-arm64-v8a-debug-win"
        },
        {
            "name": "android-arm64-v8a-release-win",
            "configurePreset": "android-arm64-v8a-release-win"
        },
        {
            "name": "android-x86_64-debug-win",
            "configurePreset": "android-x86_64-debug-win"
        },
        {
            "name": "android-x86_64-release-win",
            "configurePreset": "android-x86_64-release-win"
        },
        {
            "name": "android-x86-debug-win",
            "configurePreset": "android-x86-debug-win"
        },
        {
            "name": "android-x86-release-win",
            "configurePreset": "android-x86-release-win"
        },
        {
            "name": "install-android-arm64-v8a-debug-win",
            "configurePreset": "android-arm64-v8a-debug-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-arm64-v8a-release-win",
            "configurePreset": "android-arm64-v8a-release-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-x86_64-debug-win",
            "configurePreset": "android-x86_64-debug-win",
            "targets": [
                "install"
            ]
        },
        {
            "name": "install-android-x86_64-release-win",
            "configurePreset": "android-x86_64-release-win",
