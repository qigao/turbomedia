{
  "name": "turbomedia",
  "version-semver": "1.0.0",
  "dependencies": [
    "miniaudio",
    "stb",
    "libyuv",
    "openssl",
    "roaring",
    "usrsctp"
  ],
  "features": {
    "opus": {
      "description": "Build TurboMedia Opus codec support.",
      "dependencies": [
        "opus"
      ]
    },
    "vpx": {
      "description": "Build TurboMedia VP8/VP9 codec support.",
      "dependencies": [
        "libvpx"
      ]
    },
    "h264": {
      "description": "Build TurboMedia H.264 codec support.",
      "dependencies": [
        "openh264"
      ]
    },
    "h265": {
      "description": "Build TurboMedia H.265 codec support.",
      "dependencies": [
        "x265",
        "libde265"
      ]
    },
    "ffmpeg": {
      "description": "Install FFmpeg libraries for TurboMedia integrations.",
      "dependencies": [
        "ffmpeg"
      ]
    },
    "all-codecs": {
      "description": "Build all optional TurboMedia codec dependencies.",
      "dependencies": [
        {
          "name": "turbomedia",
          "default-features": false,
          "features": [
            "opus",
            "vpx",
            "h264",
            "h265"
          ]
        }
      ]
    }
  }
}
