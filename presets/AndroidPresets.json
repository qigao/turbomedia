{
    "version": 6,
    "include": [
        "BasePresets.json"
    ],
    "configurePresets": [
        {
            "name": "android-base",
            "hidden": true,
            "inherits": [
                "flags-android",
                "android-vcpkg-chainload"
            ],
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_SYSTEM_NAME": "Android",
                "ANDROID_STL": "c++_shared",
                "ANDROID_PLATFORM": "android-28"
            }
        },
        {
            "name": "android-vcpkg-chainload",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_MANIFEST_MODE": true
            }
        },
        {
            "name": "android-win-paths",
            "hidden": true,
            "inherits": "ISWindows",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "CMAKE_MAKE_PROGRAM": "$env{NINJA_ROOT}/ninja.exe",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/turbomedia-android",
                "CMAKE_PREFIX_PATH": "$env{PROJECT_ROOT}/turbonet/turbo-utils/build/$env{ANDROID_BUILD_VARIANT};$env{PROJECT_ROOT}/turbonet/turbonet/build/$env{ANDROID_BUILD_VARIANT};$env{PKG_ROOT}/turbohttp-android",
                "TURBOUTILS_ROOT": "$env{PROJECT_ROOT}/turbonet/turbo-utils/build/$env{ANDROID_BUILD_VARIANT}",
                "TURBONET_ROOT": "$env{PROJECT_ROOT}/turbonet/turbonet/build/$env{ANDROID_BUILD_VARIANT}",
                "TURBOHTTP_ROOT": "$env{PKG_ROOT}/turbohttp-android",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "android-arm64-v8a-debug",
            "hidden": true,
            "displayName": "Android arm64-v8a (Debug)",
            "description": "Developer build for Android ARM64",
            "inherits": [
                "android-base",
                "developer-mode"
            ],
            "binaryDir": "${sourceDir}/build/android-arm64-v8a-debug",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "VCPKG_TARGET_TRIPLET": "arm64-android"
            }
        },
        {
            "name": "android-arm64-v8a-release",
            "hidden": true,
            "displayName": "Android arm64-v8a (Release)",
            "description": "Release build for Android ARM64",
            "inherits": [
                "android-base",
                "release-mode"
            ],
            "binaryDir": "${sourceDir}/build/android-arm64-v8a-release",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "VCPKG_TARGET_TRIPLET": "arm64-android"
            }
        },
        {
            "name": "android-x86_64-debug",
            "hidden": true,
            "displayName": "Android x86_64 (Debug)",
            "description": "Developer build for Android x86_64 emulator",
            "inherits": [
                "android-base",
                "developer-mode"
            ],
            "binaryDir": "${sourceDir}/build/android-x86_64-debug",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-android"
            }
        },
        {
            "name": "android-x86_64-release",
            "hidden": true,
            "displayName": "Android x86_64 (Release)",
            "description": "Release build for Android x86_64 emulator",
            "inherits": [
                "android-base",
                "release-mode"
            ],
            "binaryDir": "${sourceDir}/build/android-x86_64-release",
            "cacheVariables": {
                "ANDROID_ABI": "x86_64",
                "VCPKG_TARGET_TRIPLET": "x64-android"
            }
        },
        {
            "name": "android-x86-debug",
            "hidden": true,
            "displayName": "Android x86 (Debug)",
            "description": "Developer build for Android x86 emulator",
            "inherits": [
                "android-base",
                "developer-mode"
            ],
            "binaryDir": "${sourceDir}/build/android-x86-debug",
            "cacheVariables": {
                "ANDROID_ABI": "x86",
                "VCPKG_TARGET_TRIPLET": "x86-android"
            }
        },
        {
            "name": "android-x86-release",
            "hidden": true,
            "displayName": "Android x86 (Release)",
            "description": "Release build for Android x86 emulator",
            "inherits": [
                "android-base",
                "release-mode"
            ],
            "binaryDir": "${sourceDir}/build/android-x86-release",
            "cacheVariables": {
                "ANDROID_ABI": "x86",
                "VCPKG_TARGET_TRIPLET": "x86-android"
            }
        }
    ]
}
