{
    "version": 6,
    "configurePresets": [
        {
            "name": "pkg-vcpkg",
            "hidden": true,
            "cacheVariables": {
                "VCPKG_MANIFEST_MODE": true,
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays"
            }
        },
        {
            "name": "developer-mode",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-mode",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}
