# TurboNet WebRTC Signaling Server Configuration

[server]
# Unique identifier for this node (default: auto-generated)
# node_id = "node-1"

# WebSocket server settings
host = "0.0.0.0"
port = 8080

# TLS Configuration (recommended for production)
use_tls = false
# cert_file = "/etc/ssl/certs/server.crt"
# key_file = "/etc/ssl/private/server.key"

[http_api]
# Helper API for management and monitoring
enabled = true
host = "0.0.0.0"
port = 8081
require_auth_for_monitoring = false

[limits]
# Resource limits
max_peers = 1000
max_rooms = 100
peer_timeout_ms = 60000  # 60 seconds

[auth]
# JWT Authentication settings
enabled = false
# secret = "change_this_to_a_secure_random_string"
ttl_seconds = 3600
algorithm = "HS256"

[redis]
# Redis integration for clustering
enabled = false
host = "localhost"
port = 6379
# password = "redis_password"
db = 0

# Redis Streams settings
use_streams = true
stream_read_interval_ms = 100
stream_max_len = 1000

[logging]
# Log settings: trace, debug, info, warn, error
level = "info"
# Format: text, json
format = "text"
# Output: stdout, file
output = "stdout"
