# TurboNet WebRTC Signaling Server Configuration

[server]
# Unique identifier for this node (default: auto-generated)
# node_id = "node-1"

# WebSocket server settings
host = "0.0.0.0"
port = 8080

# WSS is terminated in-process by CoroNet/BoringSSL.
use_tls = false
# cert_file = "/etc/turbomedia/tls/signaling-chain.pem"
# key_file = "/etc/turbomedia/tls/signaling-key.pem"

[http_api]
# Management and monitoring API. Configure either the scoped [http_auth]
# verifier or the static TURBO_SIGNALING_ADMIN_TOKEN compatibility token
# before enabling it.
enabled = false
host = "0.0.0.0"
port = 8081
use_tls = false
# cert_file = "/etc/turbomedia/tls/management-chain.pem"
# key_file = "/etc/turbomedia/tls/management-key.pem"
auth_enabled = true

#[http_auth]
#issuer = "turbomedia"
#active_key_id = "signaling-management-2026-07"
#active_secret = "replace-with-at-least-32-random-bytes"
#previous_key_id = "signaling-management-2026-06"
#previous_secret = "replace-with-at-least-32-random-bytes"
#revoked_token_sha256 = "one-or-more-comma-separated-lowercase-sha256-digests"
#clock_skew_seconds = 30
#max_ttl_seconds = 3600

[limits]
# Resource limits
max_peers = 1000
max_rooms = 100
peer_timeout_ms = 60000  # 60 seconds
join_timeout_ms = 10000  # Fixed deadline for the first successful join
max_message_size = 65536 # Complete WebSocket message bytes
messages_per_second = 100
message_burst = 200
max_outbox_messages = 256
max_outbox_bytes = 1048576
# Applied after the WebSocket upgrade, using the socket peer IP (port ignored).
max_connections_per_source = 100
source_admissions_per_second = 20
source_admission_burst = 50
max_source_states = 4096
source_state_ttl_ms = 300000

[auth]
# Browser-compatible peer admission. When enabled, the first application
# message must be:
# {"type":"join","room":"room-a","peer_id":"alice","token":"<signed token>"}
# The token must use audience "turbomedia-signaling-peer", scope
# "signaling.peer.join", and exact room_id/participant_id claims.
enabled = false
# issuer = "turbomedia"
# active_key_id = "signaling-peer-2026-07"
# secret = "replace-with-at-least-32-random-bytes"
# previous_key_id = "signaling-peer-2026-06"
# previous_secret = "replace-with-at-least-32-random-bytes"
# revoked_token_sha256 = "one-or-more-comma-separated-lowercase-sha256-digests"
# clock_skew_seconds = 30
ttl_seconds = 3600
algorithm = "HS256"

[redis]
# Reserved settings. The current signaling server rejects enabled=true.
enabled = false
host = "localhost"
port = 6379
# password = "redis_password"
db = 0

# Redis Streams settings
use_streams = true
stream_read_interval_ms = 100
stream_max_len = 1000

[logging]
# Log settings: trace, debug, info, warn, error
level = "info"
# The current application supports text on stdout only.
format = "text"
output = "stdout"
