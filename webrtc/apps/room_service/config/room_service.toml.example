# TurboMedia room service configuration
#
# Precedence:
#   built-in defaults < this file < environment variables < command line

[server]
host = "0.0.0.0"
port = 9090
use_tls = false
# cert_file = "/etc/turbomedia/tls/room-service-chain.pem"
# key_file = "/etc/turbomedia/tls/room-service-key.pem"
node_id = "room-service-1"

[control]
# Static compatibility token. Prefer scoped [auth] tokens for production.
# Prefer TURBO_ROOM_SERVICE_CONTROL_TOKEN when this compatibility mode is used.
token = "replace-with-a-control-token"

# Scoped Room control token verifier. Uncomment both active key fields together.
# Secrets must contain at least 32 bytes and should come from the environment:
#   TURBO_ROOM_SERVICE_AUTH_ACTIVE_KEY_ID
#   TURBO_ROOM_SERVICE_AUTH_ACTIVE_SECRET
# During rotation, configure the previous key pair until all old tokens expire.
#[auth]
#issuer = "turbomedia"
#active_key_id = "room-control-2026-07"
#active_secret = "replace-with-at-least-32-random-bytes"
#previous_key_id = "room-control-2026-06"
#previous_secret = "replace-with-at-least-32-random-bytes"
#revoked_token_sha256 = "one-or-more-comma-separated-lowercase-sha256-digests"
#clock_skew_seconds = 30
#max_ttl_seconds = 3600

[sfu]
control_url = "https://sfu-node-1.internal:9190"
nodes = "sfu-node-1=https://sfu-node-1.internal:9190"
# Omit ca_file for public/system-trusted certificates. For a private PKI,
# configure its CA bundle; peer and hostname verification remain mandatory.
# ca_file = "/etc/turbomedia/tls/internal-ca.pem"
# Static compatibility path. A configured [sfu_auth] signer takes precedence.
control_token = "replace-with-the-sfu-control-token"

# Per-command scoped token signer used by Room -> SFU http_client calls.
# The matching active/previous verifier key must be deployed on every SFU first.
#[sfu_auth]
#issuer = "turbomedia"
#key_id = "sfu-control-2026-07"
#secret = "replace-with-at-least-32-random-bytes"
#ttl_seconds = 60

[capacity]
max_rooms = 1024

[rooms]
auto_create = true

[runtime]
dry_run = false

[logging]
level = "info"

# Iris is the workflow owner. RoomService connects to the Iris FlowMQ ROUTER
# as a DEALER and requires application-level receipt/completion/event ACKs.
# Prefer environment variables for credentials and deployment-specific paths:
#   TURBO_ROOM_SERVICE_IRIS_FLOWMQ_HOST
#   TURBO_ROOM_SERVICE_IRIS_FLOWMQ_PORT
#   TURBO_ROOM_SERVICE_IRIS_PROVIDER_INSTANCE_ID
#   TURBO_ROOM_SERVICE_IRIS_IDENTITY
#   TURBO_ROOM_SERVICE_IRIS_CERTIFICATE_SHA256
#   TURBO_ROOM_SERVICE_IRIS_FLOWMQ_CA_FILE
#   TURBO_ROOM_SERVICE_IRIS_FLOWMQ_CERT_FILE
#   TURBO_ROOM_SERVICE_IRIS_FLOWMQ_KEY_FILE
#   TURBO_ROOM_SERVICE_IRIS_EVENT_STORE_CONFIG
#   TURBO_ROOM_SERVICE_IRIS_EVENT_STORE_CHANNEL
#   TURBO_ROOM_SERVICE_IRIS_ALLOW_DEVELOPMENT_SQLITE
#   TURBO_ROOM_SERVICE_IRIS_DEAD_RETENTION_SECONDS
#   TURBO_ROOM_SERVICE_IRIS_ARCHIVE_RETENTION_SECONDS
#   TURBO_ROOM_SERVICE_IRIS_RETENTION_SWEEP_INTERVAL_MS
#   TURBO_ROOM_SERVICE_IRIS_RETENTION_SWEEP_BATCH_SIZE
#[iris_provider]
#flowmq_host = "iris.internal"
#flowmq_port = 17813
#flowmq_topic = "media-provider-v1"
#provider_instance_id = "room-service-1"
#iris_identity = "iris-router-1"
#iris_certificate_sha256 = "sha256:replace-with-64-lowercase-hex-digits"
#flowmq_ca_file = "/etc/turbomedia/tls/flowmq-ca.pem"
#flowmq_cert_file = "/etc/turbomedia/tls/room-flowmq-chain.pem"
#flowmq_key_file = "/etc/turbomedia/tls/room-flowmq-key.pem"
#flowmq_server_name = "iris.internal"
#flowmq_use_tls = true
#flowmq_allow_insecure_loopback = false
# Production FlowStore configuration should select redis or postgresql.
# SQLite is intended only for local development.
#event_store_config = "/etc/turbonet/room-service-flowstore.yaml"
#event_store_channel = "iris.media_events"
# Command intent/outcome records require a distinct RecordStore namespace;
# they must not share the event outbox channel.
#command_ledger_channel = "iris.provider_commands"
#allow_development_sqlite = false
#correlation_capacity = 1024
#completion_queue_capacity = 1024
#reconcile_inventory_queue_capacity = 8
#outbox_request_queue_capacity = 1024
#command_ledger_queue_capacity = 1024
#command_terminal_retention_seconds = 2592000
#command_retention_batch_size = 128
# A terminal dead letter remains replayable for this interval. It is then
# atomically rewritten as an immutable archive record. Archive records are
# CAS-deleted only after the second interval.
#dead_retention_seconds = 86400
#archive_retention_seconds = 2592000
#retention_sweep_interval_ms = 60000
#retention_sweep_batch_size = 128
#retry_max_attempts = 8
#retry_backoff_ms = 250
#ack_timeout_ms = 5000
#drain_timeout_ms = 30000

# Optional IVR FlowMQ bridge (ROUTER command endpoint + PUB domain events).
# bind_port <= 0 keeps the HTTP-only control path and disables the bridge.
# An enabled bridge requires mTLS. Plaintext is accepted only when both the
# bind address is loopback and allow_insecure_loopback is explicitly true.
# Inject shared_secret with TURBO_ROOM_SERVICE_FMQ_SHARED_SECRET; do not store
# the production secret in this file.
#[fmq]
#bind_host = "127.0.0.1"
#bind_port = 17713
# Endpoint host may carry a scheme prefix that selects the transport, e.g.
# bind_host = "tls://127.0.0.1" or "wss://127.0.0.1" (port still in bind_port).
# TLS/WSS require the ca_file/cert_file/key_file below.
#pub_port = 17714
#pub_topic = "room.events"
#worker_heartbeat_ms = 5000
#worker_lease_ms = 15000
#dispatch_deadline_ms = 5000
# Maximum simultaneously tracked Iris IVR dialogs. Queue-full behavior is
# fail-fast; size this for peak active + opening + closing dialogs.
#dialog_capacity = 256
#use_tls = true
#ca_file = "/etc/turbomedia/tls/flowmq-ca.pem"
#cert_file = "/etc/turbomedia/tls/room-flowmq-chain.pem"
#key_file = "/etc/turbomedia/tls/room-flowmq-key.pem"
#rotation_generation = 1

#[[fmq.workers]]
#worker_id = "ivr-worker-1"
#active_certificate_sha256 = "sha256:replace-with-64-lowercase-hex-digits"
#generation = 1
# During a bounded rotation window, also set previous_certificate_sha256 and
# previous_expires_at_ms (Unix epoch milliseconds). Remove both after expiry.
#
# P0-04.4 authorization scope (all optional). tenant_id uses the
# "<tenant>/" room_id prefix convention. room_scope / call_scope /
# content_capabilities are "*" (any) or comma-separated exact ids; the
# worker is only authorized for matching commands and only selected for
# dispatches it may serve. pub_topics is the comma-separated PUB/SUB topic
# allowlist (defaults to [fmq].pub_topic when absent).
#tenant_id = "acme"
#room_scope = "acme/room-1,acme/room-2"
#call_scope = "*"
#content_capabilities = "conference-greeting"
#pub_topics = "room.events"
