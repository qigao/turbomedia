version: 1

# TurboMedia exports only the SQLite TurboDB ORM backend. PostgreSQL support,
# when required by a deployment, must be supplied from TurboDB build output;
# TurboMedia does not link or deploy libpq.
channels:
  iris.media_events:
    kind: record_store
    config:
      backend: sqlite
      database_path: room-service-iris-events.sqlite3
      namespace_name: iris.media_events
      busy_timeout_ms: 5000
      max_records: 10000
      max_bytes: 67108864
      max_item_bytes: 16384
      max_key_size: 128
      max_value_size: 16384
      max_batch_size: 256

adapters: {}
