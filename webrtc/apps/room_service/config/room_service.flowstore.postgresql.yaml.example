version: 1

# Production PostgreSQL profile. The libpq service definition and .pgpass (or
# an equivalent secret-mounted credential file) own endpoints, TLS policy, and
# credentials; secrets do not belong in this YAML file.
# max_records is a hard admission bound exported as record_capacity; alert on
# total pending + in-flight + dead records before this limit is reached.
channels:
  iris.media_events:
    kind: record_store
    config:
      backend: postgresql
      conninfo: "service=turbomedia-iris-outbox"
      namespace_name: iris.media_events
      max_key_size: 128
      max_value_size: 16384
      max_batch_size: 256
      max_records: 100000
      create_table: true

adapters: {}
