{
  "targets": {
    "test_ivr_control_adapter": {
      "kind": "executable",
      "sources": {
        "files": ["test_ivr_control_adapter.c", "../src/ivr_control_adapter.c"]
      },
      "private": {
        "deps": ["turbo_media_rtc_apps", "turbo_media_rtc", "turbo_media_ivr", "salts_tinytest"],
        "includeDirs": [
          "../include",
          "../src",
          "../../../ivr/src",
          "../../../ivr/include",
          "../../../tests",
          "../../../../media/codec/include",
          "../../../include",
          "../../../../sip/sdp/include",
          "../../../../sip/rtp/include",
          "../../../../media/speech/include",
          "../../../../media/recognition/include",
          "../../../../media/containers/demuxer/include",
          "../../../../media/containers/muxer/include",
          "$builddir/webrtc/ivr/generated"
        ],
        "defines": {
          "TURBO_MEDIA_HAS_IVR_CONTROL": null
        }
      },
      "test": {
        "timeout": 60
      }
    },
    "test_ivr_whip_transport": {
      "kind": "executable",
      "sources": {
        "files": ["test_ivr_whip_transport.c"]
      },
      "private": {
        "deps": ["turbo_media_ivr_rtc", "salts_tinytest", "turbo_media_rtp"],
        "libs": ["ws2_32"],
        "includeDirs": [
          "../../../ivr/src",
          "../../../ivr/include",
          "../../../tests",
          "../../../../media/codec/include",
          "../../../../media/speech/include",
          "$builddir/webrtc/ivr/generated",
          "../../../include",
          "../../../../sip/sdp/include",
          "../../../../sip/rtp/include",
          "../../../../media/recognition/include",
          "../../../../media/containers/demuxer/include",
          "../../../../media/containers/muxer/include"
        ],
        "defines": {
          "TEST_BIN_DIR": "\"$builddir/bin\"",
          "SFU_NODE_BIN": "\"sfu_node\""
        }
      },
      "test": {
        "timeout": 240
      }
    },
    "test_room_service_app": {
      "kind": "executable",
      "sources": {
        "files": [
          "test_room_service_app.c",
          "../src/config.c",
          "../src/http_api.c",
          "../src/server.c",
          "../src/ivr_control_adapter.c",
          "../../sfu_node/src/config.c",
          "../../sfu_node/src/http_api.c",
          "../../sfu_node/src/server.c"
        ]
      },
      "private": {
        "deps": [
          "turbo_media_rtc_apps",
          "turbo_media_rtc",
          "turbo_media_transport",
          "chttp_client",
          "chttp_server",
          "turbo_media_auth",
          "turbo_media_revocation_https",
          "turbo_media_tenant_quota",
          "turbo_media_tenant_quota_wire",
          "salts_crypto",
          "salts_core",
          "salts_jsonparser",
          "salts_tomlparser",
          "salts_cyaml",
          "salts_datetimeparser",
          "salts_tinytest",
          "turbo_media_ivr",
          "turbo_media_sdp",
          "turbo_media_rtp"
        ],
        "includeDirs": [
          "../include",
          "../../sfu_node/include",
          "../../../tests",
          "../../../ivr/src",
          "../../../ivr/include",
          "../../../../media/codec/include",
          "../../../include",
          "../../../../sip/sdp/include",
          "../../../../sip/rtp/include",
          "../../../../media/speech/include",
          "../../../../media/recognition/include",
          "../../../../media/containers/demuxer/include",
          "../../../../media/containers/muxer/include",
          "../../../../streaming/transport/include",
          "../../../src/auth",
          "../../../src/security",
          "$builddir/webrtc/ivr/generated"
        ],
        "defines": {
          "TURBO_MEDIA_HAS_IVR_CONTROL": null,
          "ROOM_SERVICE_ENABLE_TEST_HOOKS": "1",
          "ROOM_SERVICE_TEST_TLS_CERT_PATH": "\"$root/webrtc/tests/fixtures/tls/localhost-cert.pem\"",
          "ROOM_SERVICE_TEST_TLS_KEY_PATH": "\"$root/webrtc/tests/fixtures/tls/localhost-key.pem\""
        },
        "flags": ["-Wall", "-Wextra", "-Wpedantic"]
      },
      "test": {
        "timeout": 120
      }
    },
    "test_sfu_minimal_environment": {
      "kind": "executable",
      "sources": {
        "files": ["test_sfu_minimal_environment.c"]
      },
      "private": {
        "deps": ["turbo_media_ivr", "salts_tinytest"],
        "libs": ["ws2_32"],
        "includeDirs": [
          "../../../tests",
          "../../../ivr/src",
          "../../../ivr/include",
          "../../../../media/codec/include",
          "../../../../media/speech/include",
          "$builddir/webrtc/ivr/generated"
        ],
        "defines": {
          "TEST_BIN_DIR": "\"$builddir/bin\"",
          "SFU_NODE_BIN": "\"sfu_node\""
        }
      },
      "test": {
        "timeout": 60
      }
    },
    "turbo_media_test_room_service_config": {
      "kind": "executable",
      "sources": {
        "files": ["test_room_service_config.c", "../src/config.c"]
      },
      "private": {
        "deps": ["turbo_media_auth", "salts_tinytest", "salts_core", "salts_tomlparser"],
        "includeDirs": ["../include", "../../../src/auth"],
        "defines": {
          "ROOM_SERVICE_CONFIG_EXAMPLE_PATH": "\"$root/webrtc/apps/room_service/config/room_service.toml.example\""
        }
      },
      "test": {}
    },
    "turbo_media_test_room_service_dry_run": {
      "kind": "header_only",
      "runtimeDeps": ["room_service"],
      "test": {
        "program": "${artifact:room_service}",
        "timeout": 10,
        "args": ["--config", "$root/webrtc/apps/room_service/config/room_service.toml.example", "--dry-run"]
      }
    },
    "turbo_media_test_room_service_log_redaction": {
      "kind": "header_only",
      "runtimeDeps": ["room_service"],
      "test": {
        "timeout": 10,
        "tool": "cmake",
        "args": [
          "-DREJECT_OUTPUT=room-log-secret|room-url-secret|room-node-secret|room-auth-secret",
          "-P",
          "$root/cmake/RunSlateCheck.cmake",
          "--",
          "${artifact:room_service}",
          "--config",
          "$root/webrtc/apps/room_service/config/room_service.toml.example",
          "--dry-run",
          "--sfu-control-url",
          "https://user:room-log-secret@example.invalid/control?token=room-url-secret",
          "--sfu-nodes",
          "node-a=https://user:room-node-secret@example.invalid",
          "--auth-key-id",
          "active",
          "--auth-secret",
          "room-auth-secret-0123456789abcdef0123456789abcdef"
        ]
      }
    }
  }
}
