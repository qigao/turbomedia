{
  "include": ["tests/module.json"],
  "targets": {
    "room_service": {
      "kind": "executable",
      "sources": {
        "files": ["src/main.c", "src/config.c", "src/http_api.c", "src/server.c", "src/ivr_control_adapter.c"]
      },
      "private": {
        "deps": [
          "turbo_media_rtc_apps",
          "turbo_media_transport",
          "chttp_client",
          "chttp_app",
          "turbo_media_auth",
          "turbo_media_revocation_https",
          "salts_crypto",
          "salts_core",
          "salts_jsonparser",
          "salts_tomlparser",
          "salts_cyaml",
          "salts_datetimeparser",
          "turbo_media_ivr"
        ],
        "includeDirs": [
          "include",
          "../../ivr/src",
          "../../ivr/include",
          "../../../media/codec/include",
          "../../include",
          "../../../sip/sdp/include",
          "../../../sip/rtp/include",
          "../../../media/speech/include",
          "../../../media/recognition/include",
          "../../../media/containers/demuxer/include",
          "../../../media/containers/muxer/include",
          "../../../streaming/transport/include",
          "../../src/auth",
          "$builddir/webrtc/ivr/generated"
        ],
        "defines": {
          "TURBO_MEDIA_HAS_IVR_CONTROL": null
        },
        "flags": ["-Wall", "-Wextra", "-Wpedantic"]
      },
      "install": {
        "assets": [
          {
            "from": "config/room_service.toml.example",
            "to": "etc/turbomedia"
          }
        ]
      }
    }
  }
}
