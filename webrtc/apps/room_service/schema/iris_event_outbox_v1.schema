// RoomService-owned durable delivery state for Iris media events.
//
// The media event remains a provider fact. This record adds only transport
// delivery state; it never owns Iris workflow/session state.

schema IrisEventOutboxV1 [id(22001), byte_order(little)];

[id(1)]
// Persistence uses JSON field names; declaration order is not a storage contract.
// Fixed fields precede strings to satisfy the native generator layout contract.
message IrisMediaEventOutboxRecordV1 {
  uint32 schema_version;
  uint64 state_changed_at_ms;
  uint64 archived_at_ms;
  uint32 delivery_attempts;
  int32 last_http_status;
  uint64 call_generation;
  uint64 sequence;
  uint64 occurred_at_ms;
  string delivery_state; // pending | in_flight | dead | archived
  string event_id;
  string tenant_id;
  string provider_session_id;
  string dialog_id;
  string worker_id;
  string room_id;
  string call_id;
  string event_type;
  string input_id;
  string input_value;
  string payload_json;
}
