{
  "include": ["tests/module.json"],
  "targets": {
    "sfu_node": {
      "kind": "executable",
      "sources": {
        "files": ["src/main.c", "src/config.c", "src/http_api.c", "src/server.c"]
      },
      "private": {
        "deps": [
          "turbo_media_rtc_apps",
          "turbo_media_rtc",
          "chttp_client",
          "chttp_app",
          "turbo_media_auth",
          "turbo_media_tenant_quota",
          "turbo_media_tenant_quota_wire",
          "salts_crypto",
          "salts_core",
          "salts_jsonparser",
          "salts_tomlparser",
          "turbo_media_sdp",
          "turbo_media_rtp"
        ],
        "includeDirs": [
          "include",
          "../../../media/codec/include",
          "../../include",
          "../../../sip/sdp/include",
          "../../../sip/rtp/include",
          "../../../media/speech/include",
          "../../../media/recognition/include",
          "../../../media/containers/demuxer/include",
          "../../../media/containers/muxer/include",
          "../../src/auth",
          "../../src/security"
        ],
        "flags": ["-Wall", "-Wextra", "-Wpedantic"]
      },
      "install": {
        "assets": [
          {
            "from": "config/sfu_node.toml.example",
            "to": "etc/turbomedia"
          }
        ]
      }
    }
  }
}
