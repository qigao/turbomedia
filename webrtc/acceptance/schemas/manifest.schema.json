{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbonet.example/schemas/webrtc-acceptance/manifest-v1.json",
  "title": "TurboMedia WebRTC acceptance manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "source", "grid", "sfu", "turn", "topologies", "scenarios", "phase_deadlines", "threshold_profile", "artifact_directory"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": { "enum": ["diagnostic", "release", "contract_lab"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "require_clean_tree", "test_page_url", "test_page_sha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "require_clean_tree": { "type": "boolean" },
        "test_page_url": { "type": "string", "minLength": 1 },
        "test_page_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_env", "browsers"],
      "properties": {
        "endpoint_env": { "type": "string", "minLength": 1 },
        "browsers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "platform"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "platform": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "sfu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "whip_endpoint", "whep_endpoint", "token_provider"],
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "whip_endpoint": { "type": "string", "minLength": 1 },
        "whep_endpoint": { "type": "string", "minLength": 1 },
        "token_provider": { "$ref": "#/$defs/command" }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_provider"],
      "properties": {
        "credential_provider": { "$ref": "#/$defs/command" }
      }
    },
    "topologies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topology_id", "hooks"],
        "properties": {
          "topology_id": { "type": "string", "minLength": 1 },
          "hooks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["setup", "transition", "teardown"],
            "properties": {
              "setup": { "$ref": "#/$defs/command" },
              "transition": { "$ref": "#/$defs/command" },
              "teardown": { "$ref": "#/$defs/command" },
              "probe": { "$ref": "#/$defs/command" }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "topology_id", "sample_interval_ms", "duration_ms"],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "topology_id": { "type": "string", "minLength": 1 },
          "sample_interval_ms": { "type": "integer", "minimum": 250, "maximum": 3600000 },
          "duration_ms": { "type": "integer", "minimum": 1, "maximum": 3600000 }
        }
      }
    },
    "phase_deadlines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight_ms", "connect_ms", "stable_ms", "transition_ms", "recovery_ms", "drain_ms"],
      "properties": {
        "preflight_ms": { "$ref": "#/$defs/duration" },
        "connect_ms": { "$ref": "#/$defs/duration" },
        "stable_ms": { "$ref": "#/$defs/duration" },
        "transition_ms": { "$ref": "#/$defs/duration" },
        "recovery_ms": { "$ref": "#/$defs/duration" },
        "drain_ms": { "$ref": "#/$defs/duration" }
      }
    },
    "threshold_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "stable", "recovery", "drain"],
      "properties": {
        "profile_id": { "type": "string", "minLength": 1 },
        "stable": { "$ref": "#/$defs/thresholds" },
        "recovery": { "$ref": "#/$defs/thresholds" },
        "drain": { "$ref": "#/$defs/thresholds" }
      }
    },
    "artifact_directory": { "type": "string", "minLength": 1 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cases": { "type": "integer", "minimum": 1, "maximum": 256 },
        "max_provider_output_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_hook_output_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "max_case_log_bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "max_samples_per_case": { "type": "integer", "minimum": 1, "maximum": 36000 },
        "max_artifact_bytes_per_case": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "duration": { "type": "integer", "minimum": 1, "maximum": 3600000 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum_samples": { "type": "integer", "minimum": 1, "maximum": 36000 },
        "maximum_duration_ms": { "$ref": "#/$defs/duration" },
        "max_rtt_ms": { "type": "number", "minimum": 0 },
        "max_jitter_ms": { "type": "number", "minimum": 0 },
        "max_loss_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_media_delta": { "type": "integer", "minimum": 0 },
        "max_drain_duration_ms": { "$ref": "#/$defs/duration" }
      }
    }
  }
}
