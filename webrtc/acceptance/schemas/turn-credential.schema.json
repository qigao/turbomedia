{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turbonet.example/schemas/webrtc-acceptance/turn-credential-v1.json",
  "title": "TurboMedia short-lived TURN credential v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider_id", "credential_id", "urls", "username", "credential", "issued_at", "expires_at", "coturn_version"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "credential_id": { "type": "string", "minLength": 1 },
    "urls": { "type": "array", "minItems": 1, "$comment": "limits:maxItems=MAX_CASES", "items": { "type": "string", "minLength": 1 } },
    "username": { "type": "string", "minLength": 1 },
    "credential": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "coturn_version": { "type": "string", "minLength": 1 }
  }
}
