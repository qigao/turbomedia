{
  "include": ["apps/module.json", "examples/module.json", "ivr/module.json", "tests/module.json"],
  "targets": {
    "turbo_media_auth": {
      "kind": "static",
      "sources": {
        "files": [
          "src/auth/turbo_media_auth.c",
          "src/auth/turbo_media_revocation.c",
          "src/auth/turbo_media_revocation_projection.c",
          "src/auth/turbo_media_revocation_wire.c",
          "src/auth/turbo_media_revocation_fanout.c"
        ]
      },
      "public": {
        "includeDirs": ["src/auth"]
      },
      "private": {
        "deps": ["salts_jsonparser", "salts_crypto", "salts_core"]
      }
    },
    "turbo_media_datachannel": {
      "kind": "shared",
      "outputPrefix": "lib",
      "sources": {
        "files": [
          "src/turbo_datachannel.c",
          "src/dc_certificate.c",
          "src/turbo_datachannel_errors.c",
          "src/turbo_dc_msg.c",
          "src/dcep_protocol.c",
          "src/dtls_session.c",
          "src/sctp_session.c",
          "src/stb_sprintf.c"
        ]
      },
      "public": {
        "deps": ["turbo_media_sdp", "salts_ltvparser"],
        "includeDirs": ["../media/codec/include", "include"]
      },
      "private": {
        "deps": [
          "turbo_media_cnet_adapter",
          "salts_cnet",
          "saltsnet_ice",
          "salts_core",
          "cmeta_cstl",
          "vcpkg_usrsctp",
          "salts_crypto",
          "vcpkg_roaring"
        ],
        "includeDirs": ["src", "../sip/sdp/include", "../streaming/transport/internal"],
        "defines": {
          "SHARED_CXX": null,
          "turbo_media_datachannel_EXPORTS": null
        },
        "flags": ["-Wall", "-Wextra", "-Wno-unused-parameter"]
      },
      "install": {
        "headers": [
          {
            "from": "include/ice_integration.h",
            "to": "include"
          },
          {
            "from": "include/turbo_datachannel.h",
            "to": "include"
          },
          {
            "from": "include/turbo_datachannel_errors.h",
            "to": "include"
          },
          {
            "from": "include/turbo_dc_msg.h",
            "to": "include"
          }
        ]
      }
    },
    "turbo_media_http_media_client": {
      "kind": "static",
      "sources": {
        "files": ["src/http/turbo_http_media_client.c"]
      },
      "public": {
        "includeDirs": ["src/http"]
      },
      "private": {
        "deps": ["chttp_client", "salts_cnet", "salts_core"]
      },
      "install": {
        "headers": [
          {
            "from": "include/http_api.h",
            "to": "include"
          }
        ]
      }
    },
