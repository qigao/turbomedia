{
    "version": 6,
    "include": [
        "presets/BuildPresets.json",
        "presets/AndroidPresets.json"
    ],
    "configurePresets": [
        {
            "name": "ci-platform-release",
            "displayName": "Platform CI (Release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/platform-$env{TURBOMEDIA_CI_PLATFORM}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_TOOLCHAIN_FILE": "$env{QIGAO_VCPKG_TOOLCHAIN_FILE}",
                "VCPKG_TARGET_TRIPLET": "$env{TURBOMEDIA_CI_TRIPLET}",
                "VCPKG_MANIFEST_MODE": false,
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/stage/platform-$env{TURBOMEDIA_CI_PLATFORM}",
                "CMAKE_C_COMPILER_LAUNCHER": "ccache",
                "CMAKE_CXX_COMPILER_LAUNCHER": "ccache",
                "CMAKE_OBJC_COMPILER_LAUNCHER": "ccache"
            }
        },
        {
            "name": "base-win-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Windows, Base)",
            "inherits": [
                "dev-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-win-release-user",
            "hidden": true,
            "displayName": "Release Build (Windows, Base)",
            "inherits": [
                "release-win-msvc-ninja",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "base-linux-dev-user",
            "hidden": true,
            "displayName": "Developer Build (Linux, Base)",
            "inherits": [
                "dev-linux-ninja",
                "pkg-vcpkg"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "ci-platform-build",
            "configurePreset": "ci-platform-release",
            "jobs": 2
        }
    ],
    "testPresets": [
        {
            "name": "ci-platform-test",
            "inherits": "base-test",
            "configurePreset": "ci-platform-release",
            "filter": {
                "exclude": {
                    "label": "performance"
                }
            },
            "execution": {
                "timeout": 120
            }
        },
        {
            "name": "base-test",
            "hidden": true,
            "displayName": "Base Test Preset",
            "description": "Base configuration for running tests",
            "filter": {
                "exclude": {
                    "label": "benchmark"
                }
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": false
            },
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "test-release-mac",
            "displayName": "Release macOS Tests",
            "inherits": "base-test",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "configurePreset": "release-mac-ninja"
        }
    ]
}
